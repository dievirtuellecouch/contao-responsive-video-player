{% extends '@Contao/content_element/player' %}

{% set shouldShowControls = not (hide_overlays|default(false)) %}

{% block headline_component %}
<div class="video-player__overlay">{{ parent() }}</div>
{% endblock headline_component %}

{% block headline_attributes %}
    {% set headline_attributes = attrs().addClass('headline') %}
    {{ headline_attributes }}
{% endblock %}

{%- block attributes -%}
    {% set attributes = attrs(attributes)
        .removeClass('content-responsive-video-player')
        .addClass('video-player')
        .set('data-module', 'video-player', shouldShowControls or sound_once|default(false) or lightbox_play|default(false))
        .setIfExists('data-icon-color', icon_color|default)
        .set('data-sound-once', 'true', sound_once|default(false))
        .set('data-hide-overlays', hide_overlays|default(false) ? 'true' : 'false')
    %}
    {% if icon_color|default %}
        {% do attributes.addStyle('--video-player-icon-color: ' ~ icon_color) %}
        {# Absolute package URLs also work in stylesheet overrides: relative
           URLs inside custom properties otherwise resolve against the theme. #}
        {% do attributes.addStyle('--video-player-icon-play: url(' ~ asset('play.svg', 'responsive_video_player') ~ ')') %}
        {% do attributes.addStyle('--video-player-icon-pause: url(' ~ asset('pause.svg', 'responsive_video_player') ~ ')') %}
        {% do attributes.addStyle('--video-player-icon-fullscreen: url(' ~ asset('fullscreen.svg', 'responsive_video_player') ~ ')') %}
    {% endif %}
    {% if figure.media.attributes.width is defined and figure.media.attributes.height is defined %}
        {% set ratioComponents = [figure.media.attributes.width, figure.media.attributes.height] %}
        {% do attributes.addStyle('--aspect-ratio: ' ~ ratioComponents | join('/') ) %}
        {% do attributes.addClass('video-player_aspect-ratio-' ~ ratioComponents | join('-')) %}
    {% endif %}
    {{ parent() }}
{%- endblock attributes -%}

{% block content %}
    {{ parent() }}
    {% if shouldShowControls %}
        <div class="video-player__play">
            <button
                type="button"
                class="video-player-button video-player-button_size-xl video-player-button_icon-play"
                data-element="video-player-button"
                data-action="play-toggle"
                aria-label="Toggle play state"
            ></button>
        </div>
        <div class="video-player__controls">
            <button
                type="button"
                class="video-player-button video-player-button_icon-play"
                data-element="video-player-button"
                data-action="play-toggle"
                aria-label="Toggle play state"
            ></button>
            {% if figure.media.attributes.controls is defined %}
            <button
                type="button"
                class="video-player-button video-player-button_icon-fullscreen"
                data-element="video-player-button"
                data-action="fullscreen"
                aria-label="Show video in fullscreen"
            ></button>
            {% endif %}
        </div>
    {% endif %}
    {% if sound_once|default(false) %}
        {% set initiallyMuted = figure.media.attributes.muted is defined %}
        <button type="button"
            class="video-player-button video-player-button_icon-sound"
            data-element="video-player-button"
            data-action="sound-once"
            aria-pressed="{{ initiallyMuted ? 'false' : 'true' }}"
            data-sound-state="{{ initiallyMuted ? 'muted' : 'audible' }}"
            data-label-sound="{{ 'tl_content.player_sound_once_label'|trans({}, 'contao_tl_content') }}"
            data-label-mute="{{ 'tl_content.player_sound_mute_label'|trans({}, 'contao_tl_content') }}"
            aria-label="{{ (initiallyMuted ? 'tl_content.player_sound_once_label' : 'tl_content.player_sound_mute_label')|trans({}, 'contao_tl_content') }}"
        ></button>
    {% endif %}
    {% if lightbox_play|default(false) and not as_editor_view %}
        <button type="button"
            class="video-player-button video-player-button_icon-lightbox"
            data-element="video-player-button"
            data-action="lightbox-play"
            aria-haspopup="dialog"
            aria-label="{{ 'tl_content.player_lightbox_open'|trans({}, 'contao_tl_content') }}"
            data-label-close="{{ 'tl_content.player_lightbox_close'|trans({}, 'contao_tl_content') }}"
            data-label-dialog="{{ 'tl_content.player_lightbox_title'|trans({}, 'contao_tl_content') }}"
        >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7.4 5v14l11-7z"/></svg>
        </button>
    {% endif %}
{% endblock content %}

{% block script %}
{% add "video_player_js" to head %}
    <script src="{{ asset('video-player.js', 'responsive_video_player') }}" defer></script>
{% endadd %}
{% endblock script %}
